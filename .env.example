# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CONTACT_RECEIVER_EMAIL: Inquiries destination email address
CONTACT_RECEIVER_EMAIL="botlytices@gmail.com"

# EmailJS Configuration
EMAILJS_SERVICE_ID="service_celhx6a"
EMAILJS_TEMPLATE_ID="template_2ls8f9w"
EMAILJS_PUBLIC_KEY="dMIkk7Bzv9al7M4bb"
EMAILJS_PRIVATE_KEY="ecwUyElCdBTGyH5wbsLIy"

# Optional SMTP Configuration (if not provided, inquiries are logged and dispatched via direct mailto fallback)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="botlytices@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="inquiries@botlytices.com"
